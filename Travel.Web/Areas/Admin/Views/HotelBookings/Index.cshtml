@model IReadOnlyList<HotelBookingDto>
@{
    ViewData["Title"] = Localizer["AdminHotelBookingsPageTitle"];
}

<div class="stat-card">
    <table class="table admin-table align-middle mb-0">
        <thead>
            <tr><th>@Localizer["Id"]</th><th>@Localizer["Hotels"]</th><th>@Localizer["TableCheckIn"]</th><th>@Localizer["TableCheckOut"]</th><th>@Localizer["TableRooms"]</th><th>@Localizer["Total"]</th><th>@Localizer["Status"]</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.Id</td>
                    <td>@b.HotelName</td>
                    <td>@b.CheckInDate.ToString("yyyy-MM-dd")</td>
                    <td>@b.CheckOutDate.ToString("yyyy-MM-dd")</td>
                    <td>@b.NumberOfRooms</td>
                    <td>@b.TotalPrice.ToUsd()</td>
                    <td><span class="badge badge-status-@b.Status">@Localizer[$"{b.Status}"]</span></td>
                    <td class="text-end">
                        <form asp-action="UpdateStatus" asp-route-id="@b.Id" method="post" class="d-flex gap-2 justify-content-end">
                            <select name="status" class="form-select form-select-sm" style="width: auto;">
                                @foreach (var s in Enum.GetValues<BookingStatus>())
                                {
                                    <option value="@s" selected="@(s == b.Status)">@Localizer[$"{s}"]</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer["UpdateStatus"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
