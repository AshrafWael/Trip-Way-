@model IReadOnlyList<DestinationDto>
@{
    ViewData["Title"] = Localizer["DestinationsPageTitle"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">@Localizer["DestinationsHeading"] (@Model.Count)</h5>
    <a class="btn btn-brand" asp-action="Create"><i class="bi bi-plus-lg"></i> @Localizer["DestinationsNew"]</a>
</div>

<div class="stat-card">
    <table class="table admin-table align-middle mb-0">
        <thead>
            <tr>
                <th>@Localizer["Name"]</th><th>@Localizer["CountryCity"]</th><th>@Localizer["PackageCount"]</th><th>@Localizer["Featured"]</th><th>@Localizer["Status"]</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.ArabicName <span class="text-muted small">(@d.Name)</span></td>
                    <td>@d.Country / @d.City</td>
                    <td>@d.PackageCount</td>
                    <td>@(d.IsFeatured ? Localizer["Yes"] : Localizer["Dash"])</td>
                    <td>
                        @if (d.IsActive)
                        {
                            <span class="badge bg-success">@Localizer["Active"]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@d.Id"><i class="bi bi-pencil"></i></a>
                        @if (d.IsActive)
                        {
                            <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline" onsubmit="return confirm('@Localizer["ConfirmDeactivateDestination"]');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
