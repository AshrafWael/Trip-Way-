@model IReadOnlyList<PackageDto>
@{
    ViewData["Title"] = Localizer["PackagesPageTitle"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">@Localizer["PackagesHeading"] (@Model.Count)</h5>
    <a class="btn btn-brand" asp-action="Create"><i class="bi bi-plus-lg"></i> @Localizer["PackagesNew"]</a>
</div>

<div class="stat-card">
    <table class="table admin-table align-middle mb-0">
        <thead>
            <tr><th>@Localizer["TableTitle"]</th><th>@Localizer["Destination"]</th><th>@Localizer["Price"]</th><th>@Localizer["AvailableSeats"]</th><th>@Localizer["Status"]</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.L()</td>
                    <td>@p.DestinationName</td>
                    <td>
                        @if (p.DiscountPrice.HasValue)
                        {
                            <span class="text-decoration-line-through text-muted small">@p.Price.ToUsdOrNull()</span>
                            <span>@p.DiscountPrice.Value.ToUsd()</span>
                        }
                        else if (p.Price.HasValue)
                        {
                            @p.Price.Value.ToUsd()
                        }
                        else
                        {
                            <span class="text-muted small">@Localizer["ContactForPrice"]</span>
                        }
                    </td>
                    <td>@p.AvailableSeats</td>
                    <td>
                        @if (p.IsActive)
                        {
                            <span class="badge bg-success">@Localizer["Active"]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id"><i class="bi bi-pencil"></i></a>
                        @if (p.IsActive)
                        {
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('@Localizer["ConfirmDeactivatePackage"]');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
