@model IReadOnlyList<ContactMessageDto>
@{
    ViewData["Title"] = Localizer["ContactMessagesPageTitle"];
}

<div class="stat-card">
    <table class="table admin-table align-middle mb-0">
        <thead><tr><th>@Localizer["Name"]</th><th>@Localizer["TableEmail"]</th><th>@Localizer["Subject"]</th><th>@Localizer["Message"]</th><th>@Localizer["Date"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr class="@(m.IsRead ? "" : "fw-bold")">
                    <td>@m.Name</td>
                    <td>@m.Email</td>
                    <td>@m.Subject</td>
                    <td class="text-muted small" style="max-width: 280px;">@m.Message</td>
                    <td>@m.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">
                        @if (!m.IsRead)
                        {
                            <form asp-action="MarkAsRead" asp-route-id="@m.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer["MarkAsRead"]</button>
                            </form>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark border">@Localizer["Read"]</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
