@model DashboardStatsDto
@{
    ViewData["Title"] = Localizer["Dashboard"];
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#e0e7ff;color:#4338ca;"><i class="bi bi-people"></i></div>
            <div>
                <div class="stat-value">@Model.TotalUsers</div>
                <div class="text-muted small">@Localizer["TotalUsers"]</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#dcfce7;color:#15803d;"><i class="bi bi-journal-check"></i></div>
            <div>
                <div class="stat-value">@Model.TotalBookings</div>
                <div class="text-muted small">@Localizer["TotalBookings"]</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#fef3c7;color:#b45309;"><i class="bi bi-suitcase"></i></div>
            <div>
                <div class="stat-value">@Model.TotalPackages</div>
                <div class="text-muted small">@Localizer["TotalPackages"]</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#fee2e2;color:#b91c1c;"><i class="bi bi-geo-alt"></i></div>
            <div>
                <div class="stat-value">@Model.TotalDestinations</div>
                <div class="text-muted small">@Localizer["TotalDestinations"]</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#d1fae5;color:#047857;"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="stat-value">@Model.Revenue.ToUsd()</div>
                <div class="text-muted small">@Localizer["Revenue"]</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#fff7ed;color:#c2410c;"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="stat-value">@Model.PendingBookings</div>
                <div class="text-muted small">@Localizer["PendingBookings"]</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#ede9fe;color:#6d28d9;"><i class="bi bi-building"></i></div>
            <div>
                <div class="stat-value">@Model.TotalHotels</div>
                <div class="text-muted small">@Localizer["AdminNavHotels"]</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#fce7f3;color:#be185d;"><i class="bi bi-journal-check"></i></div>
            <div>
                <div class="stat-value">@Model.TotalHotelBookings</div>
                <div class="text-muted small">@Localizer["AdminNavHotelBookings"]</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#fff7ed;color:#c2410c;"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="stat-value">@Model.PendingHotelBookings</div>
                <div class="text-muted small">@Localizer["PendingHotelBookings"]</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="stat-card">
            <h6 class="fw-bold mb-3">@Localizer["RecentBookings"]</h6>
            @if (Model.RecentBookings.Any())
            {
                <table class="table admin-table align-middle">
                    <thead><tr><th>@Localizer["Trip"]</th><th>@Localizer["Travelers"]</th><th>@Localizer["Total"]</th><th>@Localizer["Status"]</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr>
                                <td>@b.PackageTitle</td>
                                <td>@b.NumberOfTravelers</td>
                                <td>@b.TotalPrice.ToUsd()</td>
                                <td><span class="badge badge-status-@b.Status">@Localizer[$"{b.Status}"]</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">@Localizer["DashboardNoBookingsYet"]</p>
            }
        </div>
    </div>
    <div class="col-lg-6">
        <div class="stat-card">
            <h6 class="fw-bold mb-3">@Localizer["RecentHotelBookings"]</h6>
            @if (Model.RecentHotelBookings.Any())
            {
                <table class="table admin-table align-middle">
                    <thead><tr><th>@Localizer["Hotels"]</th><th>@Localizer["TableRooms"]</th><th>@Localizer["Total"]</th><th>@Localizer["Status"]</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.RecentHotelBookings)
                        {
                            <tr>
                                <td>@b.HotelName</td>
                                <td>@b.NumberOfRooms</td>
                                <td>@b.TotalPrice.ToUsd()</td>
                                <td><span class="badge badge-status-@b.Status">@Localizer[$"{b.Status}"]</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">@Localizer["DashboardNoHotelBookingsYet"]</p>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="stat-card">
            <h6 class="fw-bold mb-3">@Localizer["RecentUsers"]</h6>
            @if (Model.RecentUsers.Any())
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var u in Model.RecentUsers)
                    {
                        <li class="d-flex justify-content-between border-bottom py-2">
                            <span>@u.FullName</span>
                            <span class="text-muted small">@u.Email</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted mb-0">@Localizer["NoUsersYet"]</p>
            }
        </div>
    </div>
</div>
