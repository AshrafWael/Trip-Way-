@{
    ViewData["Title"] = Localizer["Error_Title"];
}
<section class="container py-5 text-center">
    <i class="bi bi-exclamation-triangle fs-1 text-danger"></i>
    <h1 class="fw-bold mt-3">@Localizer["Error_Title"]</h1>
    <p class="text-muted">@Localizer["Error_Body"]</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-brand mt-2">@Localizer["BackHome"]</a>
</section>
