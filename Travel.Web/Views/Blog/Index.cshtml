@model IReadOnlyList<BlogPostDto>
@{
    ViewData["Title"] = Localizer["Blog"];
}

<section class="hero-section" style="min-height: 320px;">
    <div class="container text-center hero-text-animate">
        <h1>@Localizer["Blog_PageTitle"]</h1>
        <p class="lead mb-0">@Localizer["Blog_PageSubtitle"]</p>
    </div>
</section>

<section class="container py-5">
    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var post in Model)
            {
                var content = post.LContent();
                var subtitle = post.LSubtitle();
                <div class="col-sm-6 col-lg-4">
                    <div class="card blog-card h-100">
                        <div class="card-img-wrap">
                            <img src="@(string.IsNullOrEmpty(post.ImageUrl) ? "/images/blog-placeholder.svg" : post.ImageUrl)" alt="@post.L()" />
                        </div>
                        <div class="card-body d-flex flex-column">
                            <p class="text-muted small mb-1">
                                <i class="bi bi-calendar"></i> @(post.PublishedAt?.ToString("yyyy-MM-dd")) &middot; @post.AuthorName
                            </p>
                            <h5 class="card-title fw-bold mb-1">@post.L()</h5>
                            @if (!string.IsNullOrWhiteSpace(subtitle))
                            {
                                <p class="text-muted small fw-bold mb-2">@subtitle</p>
                            }
                            <p class="text-muted small flex-grow-1">
                                @(content.Length > 140 ? content[..140] + "…" : content)
                            </p>
                            <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-outline-brand btn-sm border mt-2">
                                @Localizer["ReadMore"] <i class="bi bi-arrow-left"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-newspaper fs-1"></i>
            <p class="mt-2">@Localizer["NoPosts"]</p>
        </div>
    }
</section>
