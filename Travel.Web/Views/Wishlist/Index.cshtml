@model IReadOnlyList<WishlistItemDto>
@{
    ViewData["Title"] = Localizer["Wishlist_PageTitle"];
}

<section class="container py-5">
    <h1 class="section-title mb-4">@Localizer["Wishlist_PageTitle"]</h1>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="card package-card">
                        <div class="card-img-wrap">
                            <img src="@(string.IsNullOrEmpty(item.MainImageUrl) ? "/images/package-placeholder.svg" : item.MainImageUrl)" alt="@item.Title" />
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@item.Title</h5>
                            <div class="d-flex align-items-center gap-2 mb-3">
                                @if (item.DiscountPrice.HasValue)
                                {
                                    <span class="price-original">@item.Price.ToUsdOrNull()</span>
                                    <span class="price-badge">@item.DiscountPrice.Value.ToUsd()</span>
                                }
                                else if (item.Price.HasValue)
                                {
                                    <span class="price-badge">@item.Price.Value.ToUsd()</span>
                                }
                                else
                                {
                                    <span class="text-muted small">@Localizer["ContactForPrice"]</span>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-controller="Packages" asp-action="Details" asp-route-id="@item.TravelPackageId" class="btn btn-brand btn-sm flex-fill">
                                    @Localizer["ViewDetails"]
                                </a>
                                <form asp-action="Remove" asp-route-packageId="@item.TravelPackageId" method="post">
                                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-heart fs-1"></i>
            <p class="mt-2">@Localizer["EmptyMessage"]</p>
            <a asp-controller="Packages" asp-action="Index" class="btn btn-brand mt-2">@Localizer["ExplorePackages"]</a>
        </div>
    }
</section>
